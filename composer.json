{
    "name": "archlinux-de/flarum-anti-spam",
    "description": "Spam protection for forum.archlinux.de",
    "license": "GPL-3.0-or-later",
    "type": "flarum-extension",
    "require": {
        "PHP": "^8.2",
        "flarum/core": "^1.7",
        "flarum/suspend": "^1.7",
        "maxmind-db/reader": "^1.11.1",
        "symfony/http-foundation": "^5.4|^6.4|^7.4",
        "symfony/string": "^5.4|^6.4|^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "symfony/http-client": "^5.4.44|^6.4.12|^7.4",
        "symfony/filesystem": "^5.4|^6.4|^7.4",
        "flarum/testing": "^1.0.0"
    },
    "autoload": {
        "psr-4": {
            "ArchLinux\\AntiSpam\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Anti-Spam",
            "icon": {
                "name": "fas fa-shield-alt",
                "backgroundColor": "#08c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": false,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArchLinux\\AntiSpam\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    }
}
